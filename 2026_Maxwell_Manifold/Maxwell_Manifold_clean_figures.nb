Cell[CellGroupData[{

Cell["1. Load the embedded plotting definitions", "Section"],

Cell["\<\
Evaluate this input cell first. It loads the ordinary Wolfram code stored \
above. The source cell itself is intentionally not evaluatable.\
\>", "Text"],

Cell[BoxData[
 RowBox[{"Module", "[", 
  RowBox[{
   RowBox[{"{", "embedded", "}"}], ",", 
   RowBox[{
    RowBox[{"embedded", "=", 
     RowBox[{"Cases", "[", 
      RowBox[{
       RowBox[{"NotebookGet", "[", 
        RowBox[{"EvaluationNotebook", "[", "]"}], "]"}], ",", 
       RowBox[{
        RowBox[{"Cell", "[", 
         RowBox[{"code_", ",", "\"\<Code\>\"", ",", "___"}], "]"}], 
        "\[RuleDelayed]", "code"}], ",", "Infinity"}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Length", "[", "embedded", "]"}], "=!=", "1"}], ",", 
      RowBox[{
       RowBox[{"Print", "[", 
        RowBox[{
        "\"\<Expected exactly one embedded Code cell; found \>\"", ",", 
         RowBox[{"Length", "[", "embedded", "]"}], ",", "\"\<.\>\""}], "]"}], 
       ";", "\[IndentingNewLine]", 
       RowBox[{"Return", "[", "$Failed", "]"}]}]}], "]"}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"Check", "[", 
     RowBox[{
      RowBox[{"Replace", "[", 
       RowBox[{
        RowBox[{"First", "[", "embedded", "]"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"code_String", "\[RuleDelayed]", 
           RowBox[{"ToExpression", "[", 
            RowBox[{"code", ",", "InputForm"}], "]"}]}], ",", 
          RowBox[{
           RowBox[{"BoxData", "[", "boxes_", "]"}], "\[RuleDelayed]", 
           RowBox[{"ToExpression", "[", 
            RowBox[{"boxes", ",", "StandardForm"}], "]"}]}], ",", 
          RowBox[{"_", "\[RuleDelayed]", "$Failed"}]}], "}"}]}], "]"}], ",", 
      "$Failed"}], "]"}]}]}], "]"}]], "Input",
 InitializationCell->True,
 CellChangeTimes->{4.0043313789458313`*^9}]
}, Open  ]],

